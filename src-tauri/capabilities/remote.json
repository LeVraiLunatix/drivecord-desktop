{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "desktop-login-handoff",
  "description": "La page de login first-party sur drivecord.app (chargée dans la fenêtre pendant la connexion) peut remettre le token et basculer sur le shell.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://drivecord.app"
    ]
  },
  "permissions": [
    "allow-save-token",
    "allow-get-token",
    "allow-enter-shell",
    "allow-enter-auth",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-close",
    "allow-win-start-drag",
    "core:window:allow-start-dragging",
    "allow-sync-status",
    "allow-sync-pick-folder",
    "allow-sync-set-root",
    "allow-sync-enable",
    "allow-sync-disable",
    "allow-sync-now",
    "allow-sync-set-drive-enabled",
    "allow-sync-open-folder",
    "allow-sync-open-file",
    "allow-sync-uploads-status"
  ]
}
