{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drivecord",
  "version": "0.1.0",
  "identifier": "app.drivecord.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drivecord",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LeVraiLunatix",
    "license": "MIT",
    "licenseFile": "installer/license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
